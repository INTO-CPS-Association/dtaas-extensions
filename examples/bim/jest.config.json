{
  "testEnvironment": "jsdom",
  "transform": {
    "^.+\\.[tj]sx?$": [
      "ts-jest",
      {
        "tsconfig": {
          "jsx": "react-jsx",
          "allowJs": true,
          "esModuleInterop": true,
          "isolatedModules": true,
          "rootDir": "."
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@into-cps-association/dtaas-sdk|three)/)"
  ],
  "moduleNameMapper": {
    "^src/(.*?)(\\.js)?$": "<rootDir>/src/$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "setupFiles": ["<rootDir>/test/aec/setupTests.ts"],
  "setupFilesAfterEnv": ["<rootDir>/test/aec/jest.setup.ts"],
  "testRegex": "/test/(aec|kit)/.*\\.test\\.tsx?$"
}
